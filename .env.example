# ============================================================================
# Environment template — generated from src/lib/env-registry.ts
#
# This file is the complete list. `npm run env:check` and `npm run env:doctor`
# report the status of every variable below, and `npm run client:preflight`
# refuses to open first-owner registration while a required one is missing.
#
# Nothing here holds a real value. NEVER commit a filled-in copy.
# ============================================================================

# ── CORE ──────────────────────────────────────────────────────────
# Public URL used to build callback links
#   required in: production (at runtime)
#   obtain: The site address customers use, e.g. https://shop.example.com (Vercel can derive it).
NEXTAUTH_URL=

# Public URL for canonical links and email links
#   required in: production (at build)
#   obtain: Same address as NEXTAUTH_URL, or let the platform derive it.
NEXT_PUBLIC_APP_URL=

# Application name shown in metadata and emails
#   obtain: The shop or product name.
NEXT_PUBLIC_APP_NAME=

# Legacy alias for the public site URL
#   obtain: Not needed on new deployments; NEXT_PUBLIC_APP_URL supersedes it.
NEXT_PUBLIC_SITE_URL=

# Selects the normal application behaviour or the demo dataset (see src/lib/app-config.ts)
#   obtain: Leave unset. Unset means production behaviour, which is what a client deployment must run.
APP_MODE=

# ── SECURITY ──────────────────────────────────────────────────────
# Signs and encrypts session tokens
#   required in: production, preview (at runtime)
#   secret: yes — never expose this to the browser
#   obtain: Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Upstash Redis REST endpoint for the shared rate-limit store
#   required in: production, preview (at runtime)
#   required only while the rateLimit feature is enabled
#   obtain: Create a Redis database at upstash.com, open its REST API section and copy UPSTASH_REDIS_REST_URL.
UPSTASH_REDIS_REST_URL=

# Token for the Upstash Redis REST endpoint
#   required in: production, preview (at runtime)
#   required only while the rateLimit feature is enabled
#   secret: yes — never expose this to the browser
#   obtain: Same Upstash REST API section: the token is shown beside the URL.
UPSTASH_REDIS_REST_TOKEN=

# Trust x-real-ip for rate-limit keys behind your own proxy
#   obtain: Set to true only when a proxy you control sets x-real-ip. Vercel is detected automatically.
RATE_LIMIT_TRUST_PROXY=

# Registration attempts allowed per minute per caller
#   obtain: Defaults to 3.
RATE_LIMIT_REGISTER_MAX=

# Encrypts stored TOTP secrets
#   secret: yes — never expose this to the browser
#   obtain: Generate with: openssl rand -base64 32
TWO_FACTOR_ENCRYPTION_KEY=

# Force owners to enrol in 2FA before using the dashboard
#   required only while the twoFactorPolicy feature is enabled
#   obtain: Set true when you want to enforce enrolment.
REQUIRE_OWNER_2FA=

# Enable nonce-based Content-Security-Policy
#   obtain: Enable only after staging verification of every surface.
CSP_NONCE_ENABLED=

# ── DATABASE ──────────────────────────────────────────────────────
# PostgreSQL connection string
#   required in: production, preview (at runtime)
#   secret: yes — never expose this to the browser
#   obtain: Create a Postgres database (Neon, Vercel Postgres, RDS, Supabase) and copy its pooled connection string.
DATABASE_URL=

# Neon-specific alias read by scripts/vercel-build.mjs
#   secret: yes — never expose this to the browser
#   obtain: Neon sets this automatically when the database is connected through the Vercel integration.
NEON_POSTGRES_PRISMA_URL=

# ── STORAGE ───────────────────────────────────────────────────────
# Vercel Blob token for photo and media uploads
#   required only while the storage feature is enabled
#   secret: yes — never expose this to the browser
#   obtain: Create a Blob store in Vercel and connect it to the project; the token is injected by the integration.
BLOB_READ_WRITE_TOKEN=

# ── PAYMENTS ──────────────────────────────────────────────────────
# Stripe API secret key
#   required only while the payments feature is enabled
#   secret: yes — never expose this to the browser
#   obtain: Stripe dashboard → Developers → API keys. Use sk_test_… until acceptance is signed off.
STRIPE_SECRET_KEY=

# Stripe publishable key
#   required only while the payments feature is enabled
#   obtain: Stripe dashboard → Developers → API keys (pk_…).
STRIPE_PUBLISHABLE_KEY=

# Signing secret for the Stripe webhook endpoint
#   required only while the payments feature is enabled
#   secret: yes — never expose this to the browser
#   obtain: Stripe dashboard → Developers → Webhooks → your endpoint → signing secret (whsec_…).
STRIPE_WEBHOOK_SECRET=

# ── EMAIL ─────────────────────────────────────────────────────────
# Turns email notifications on
#   obtain: Set true when SMTP details are in place.
EMAIL_ENABLED=

# SMTP server host
#   required only while the email feature is enabled
#   obtain: From your email provider (e.g. smtp.postmarkapp.com).
SMTP_HOST=

# SMTP server port
#   required only while the email feature is enabled
#   obtain: Usually 587 (STARTTLS) or 465 (TLS).
SMTP_PORT=

# SMTP username
#   required only while the email feature is enabled
#   obtain: From your email provider.
SMTP_USER=

# SMTP password or API key
#   required only while the email feature is enabled
#   secret: yes — never expose this to the browser
#   obtain: From your email provider.
SMTP_PASS=

# From address on outgoing mail
#   required only while the email feature is enabled
#   obtain: An address on a domain you have verified with the provider.
SMTP_FROM=

# Use implicit TLS on the SMTP connection
#   required only while the email feature is enabled
#   obtain: true for port 465, false for 587.
SMTP_SECURE=

# Where public contact-form messages go
#   required only while the email feature is enabled
#   obtain: The shop inbox.
CONTACT_EMAIL=

# ── SMS ───────────────────────────────────────────────────────────
# Turns SMS notifications on
#   obtain: Set true when Twilio credentials are in place.
SMS_ENABLED=

# Twilio account SID
#   required only while the sms feature is enabled
#   secret: yes — never expose this to the browser
#   obtain: Twilio console dashboard.
TWILIO_ACCOUNT_SID=

# Twilio auth token
#   required only while the sms feature is enabled
#   secret: yes — never expose this to the browser
#   obtain: Twilio console dashboard.
TWILIO_AUTH_TOKEN=

# Sender number for SMS
#   required only while the sms feature is enabled
#   obtain: A number purchased in Twilio, in E.164 form.
TWILIO_PHONE_NUMBER=

# ── GOOGLE ────────────────────────────────────────────────────────
# Turns the Google Business integration on
#   obtain: Set true when OAuth credentials exist.
GOOGLE_ENABLED=

# Google OAuth client id
#   required only while the google feature is enabled
#   obtain: Google Cloud console → Credentials.
GOOGLE_CLIENT_ID=

# Google OAuth client secret
#   required only while the google feature is enabled
#   secret: yes — never expose this to the browser
#   obtain: Google Cloud console → Credentials.
GOOGLE_CLIENT_SECRET=

# Google Business Profile access token
#   required only while the google feature is enabled
#   secret: yes — never expose this to the browser
#   obtain: Issued by the OAuth flow once the shop connects its profile.
GBP_ACCESS_TOKEN=

# Google Business Profile refresh token
#   required only while the google feature is enabled
#   secret: yes — never expose this to the browser
#   obtain: Issued by the OAuth flow.
GBP_REFRESH_TOKEN=

# Google Business account id
#   required only while the google feature is enabled
#   obtain: From the in-app connect flow.
GBP_ACCOUNT_ID=

# Google Business location id
#   required only while the google feature is enabled
#   obtain: From the in-app connect flow.
GBP_LOCATION_ID=

# ── SCHEDULED_TASKS ───────────────────────────────────────────────
# Turns scheduled appointment reminders on
#   obtain: Set true when cron is configured.
REMINDERS_ENABLED=

# Bearer token required by scheduled endpoints
#   required only while the reminders feature is enabled
#   secret: yes — never expose this to the browser
#   obtain: Generate with: openssl rand -hex 24
CRON_SECRET=

# ── OBSERVABILITY ─────────────────────────────────────────────────
# Webhook that receives forwarded production error events
#   required only while the observability feature is enabled
#   secret: yes — never expose this to the browser
#   obtain: From your error tracker (Sentry, Better Stack, Datadog relay).
OBSERVABILITY_WEBHOOK_URL=

# ── TENANT_CONFIGURATION ──────────────────────────────────────────
# Single-business or multi-business resolution
#   obtain: single for a dedicated shop deployment.
TENANT_MODE=

# Pins the deployment to one business record
#   obtain: The business id after provisioning.
SINGLE_BUSINESS_ID=

# Controls first-owner and customer self-registration (see src/lib/owner-registration.ts)
#   obtain: Leave unset on a new deployment: unset behaves as onboarding, which admits the first owner and then closes.
OWNER_REGISTRATION_MODE=

# ── INTERNAL / TEST ONLY ────────────────────────────────────────
# Never set these on a customer deployment.
# Use an in-process limiter instead of Redis (tests only)
RATE_LIMIT_CI_IN_MEMORY=
# Enables the internal end-to-end booking endpoint
ENABLE_E2E_TESTS=
# Allows destructive seeding
SEED_ALLOW_DESTRUCTIVE=
# Owner email used by development seeds
SEED_OWNER_EMAIL=
# Owner password used by development seeds
SEED_OWNER_PASSWORD=
# Owner email for browser acceptance runs
E2E_OWNER_EMAIL=
# Owner password for browser acceptance runs
E2E_OWNER_PASSWORD=
# Relaxed limit used by acceptance runs
RATE_LIMIT_ACCEPT_POST_MAX=
# Elevated connection used only by the RLS administration scripts
DATABASE_ADMIN_URL=
# Database role the RLS scripts grant policies to
RLS_APP_ROLE=
# Directory holding pg_dump and pg_restore for backups
PGBIN_DIR=
# Deployment the smoke test checks
SMOKE_BASE_URL=
# Turns performance warnings into failures
PERF_STRICT=
# Base URL for the internal QA browser scripts
QA_BASE=
# Account the internal QA scripts sign in as
QA_LOGIN_EMAIL=
# Password for the internal QA account
QA_LOGIN_PASSWORD=
# Deployment Playwright runs against
E2E_BASE_URL=
# Use an already-running server instead of starting one
E2E_NO_WEBSERVER=
# Trace level for Playwright runs
E2E_TRACE=
# Relaxed read limit used by acceptance runs
RATE_LIMIT_ACCEPT_GET_MAX=
# Shop name written by the seed and provisioning scripts
SEED_BUSINESS_NAME=
# Shop slug for the seed and provisioning scripts
SEED_BUSINESS_SLUG=
# Shop contact email for the seed and provisioning scripts
SEED_BUSINESS_EMAIL=
# Shop phone for the seed and provisioning scripts
SEED_BUSINESS_PHONE=
# Shop city for the seed and provisioning scripts
SEED_BUSINESS_CITY=
# Shop state for the seed and provisioning scripts
SEED_BUSINESS_STATE=
# Shop timezone for the seed and provisioning scripts
SEED_TIMEZONE=

# ── RETIRED ────────────────────────────────────────────────────
# OWNER_PROVISIONING_TOKEN is no longer read by the application. If it exists in
# your deployment, delete it: it has no effect and only invites confusion.
