# Required
DATABASE_URL=
NEXTAUTH_SECRET=
NEXTAUTH_URL=

# Public deployment configuration
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_APP_NAME=
APP_MODE=production

# Optional tenant binding
SINGLE_BUSINESS_ID=
# Owner accounts are created ONLY via the authorized provisioning endpoint
# (/api/auth/register-owner), which requires this secret. Leave unset to
# disable owner provisioning entirely (fail-closed). No public sign-up can
# ever create an owner account.
# OWNER_PROVISIONING_TOKEN=

# Optional SMTP/email (password reset, notifications, contact)
# Feature only runs when EMAIL_ENABLED=true; env-check.ts lists it as OPTIONAL_FEATURE.
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional Twilio SMS (feature only runs when SMS_ENABLED=true)
SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Optional Google Business Profile integration (only when GOOGLE_ENABLED=true)
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GBP_ACCESS_TOKEN=
GBP_REFRESH_TOKEN=
GBP_ACCOUNT_ID=
GBP_LOCATION_ID=

# Required for media upload (Vercel Blob) — dashboard gallery/photos
BLOB_READ_WRITE_TOKEN=

# Optional active error reporting: POSTs structured error events to any
# webhook collector (Sentry/Better Stack/Datadog relay). Unset = no-op.
OBSERVABILITY_WEBHOOK_URL=

# Optional scheduled reminders (only when REMINDERS_ENABLED=true)
REMINDERS_ENABLED=false
CRON_SECRET=

# Optional test-only endpoint flag; never enable for normal client deployments
ENABLE_E2E_TESTS=false

# Client business name, contact details, address, services, staff, hours, timezone,
# and policies belong in the Business and related database records through onboarding.
# BUSINESS_TIMEZONE is intentionally not an environment variable.
