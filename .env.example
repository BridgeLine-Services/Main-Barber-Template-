# ============================================================================
# Barber Shop Booking System — Environment Variables (TEMPLATE)
# ============================================================================
# This is a TEMPLATE sold to different barbershop businesses.
# Each owner configures their own environment variables in Vercel
# (or .env for local development).
#
# ── TEMPLATE / PRODUCTION MODE ──
# Production mode is the safe default. Demo data is never seeded unless
# APP_MODE=demo is explicitly selected for local development or demos.
#
# ── PRODUCTION SETUP ──
# To convert from demo mode to a real production deployment:
#   1. Set DATABASE_URL — PostgreSQL connection string (Vercel Postgres, Neon, Supabase, etc.)
#   2. Run: npx prisma migrate deploy   (applies reviewed migrations; do not use db push in production)
#   3. Set NEXTAUTH_SECRET — random 32+ char string:  openssl rand -base64 32
#   4. Set NEXTAUTH_URL — your public deployment URL
#   5. (Optional) Set SMTP_* for booking confirmation emails
#   6. (Optional) Set TWILIO_* for SMS notifications
#
# ── ONBOARDING FLOW ──
#   1. Visit /login → click "Create Account"
#   2. Enter email + password only (no shop info yet)
#   3. Owner lands in dashboard → sees "Create Your Shop"
#   4. Enter shop details → full dashboard unlocks
# ============================================================================

# ── REQUIRED for production ──
# PostgreSQL connection string. Never commit a real connection string.
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-character-secret"

# ── OPTIONAL ──
# Core booking works without email or SMS configuration.

# Public URL used for metadata, canonical URLs, sitemap, robots, and Open Graph.
# Optional in local development; defaults to http://localhost:3000.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# NextAuth callback URL (keep aligned with your deployment URL in production)
NEXTAUTH_URL="http://localhost:3000"

# Optional single-business deployment selector.
# Set this to the Business.id after creating the client's shop. Public routes
# then work on any custom domain without requiring the hostname to equal slug.
# Leave unset when using hostname/slug tenant resolution.
# SINGLE_BUSINESS_ID="clxxxxxxxxxxxxxxxxxxxxxxxxx"

# ── Notifications — optional ──
# Core booking works when email and SMS are disabled or unconfigured.
EMAIL_ENABLED="false"
SMS_ENABLED="false"

# ── Email (Nodemailer / SMTP) — optional ──
# Used for booking confirmations and password reset
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="noreply@yourbarbershop.com"

# ── SMS (Twilio) — optional ──
# Used for booking confirmations and reminders
# SMS_PROVIDER="twilio"
# TWILIO_ACCOUNT_SID="your-sid"
# TWILIO_AUTH_TOKEN="your-token"
# TWILIO_PHONE_NUMBER="+1234567890"

# ── App Config ──
# Public app name shown in UI + PWA manifest — set per customer deployment
NEXT_PUBLIC_APP_NAME="Your Barbershop"

# ── Runtime mode ──
# Production is the safe default. Use demo mode only for local demos.
APP_MODE="production"
# For local demo data only, set APP_MODE="demo" explicitly. Never deploy
# a client with demo mode or demo credentials enabled.
