{
  "name": "barber-booking-system",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-tenant barber shop website with booking engine and dashboard. No online payments \u2014 pay in person. PROPRIETARY: licensed per client, not open source (see LICENSE).",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:vercel": "node scripts/vercel-build.mjs",
    "start": "next start",
    "lint": "eslint .",
    "architecture:check": "node scripts/check-template-architecture.mjs",
    "test:architecture": "tsx tests/architecture.test.ts",
    "test:smoke": "node scripts/smoke-test.mjs",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:setup": "prisma migrate deploy && prisma generate",
    "db:verify": "node scripts/verify-database.js",
    "db:doctor": "node scripts/db-doctor.js",
    "db:provision": "tsx scripts/provision-business.ts",
    "setup": "node scripts/setup.js",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "test:tenant": "npx tsx tests/tenant-isolation.test.ts",
    "test:matrix": "npx tsx tests/cross-tenant-matrix.test.ts",
    "test:lifecycle": "npx tsx tests/customer-data-lifecycle.test.ts",
    "test:notifications": "npx tsx tests/notification-resilience.test.ts",
    "test:business-admin": "npx tsx tests/business-admin-role.test.ts",
    "test:booking": "npx tsx tests/booking.test.ts",
    "test:permissions": "npx tsx tests/role-permissions.test.ts",
    "test:platform": "npx tsx tests/platform-owner.test.ts",
    "test:reliability": "npx tsx tests/reliability.test.ts",
    "test:factory-readiness": "npx tsx tests/factory-readiness.test.ts",
    "test:factory-launch": "npx tsx tests/factory-launch.test.ts",
    "test:barber-mode": "npx tsx tests/barber-mode.test.ts",
    "test:specialty": "npx tsx tests/specialty-match.test.ts",
    "test:portfolio": "npx tsx tests/portfolio.test.ts",
    "test:queue": "npx tsx tests/queue.test.ts",
    "test:cancellation-fill": "npx tsx tests/cancellation-fill.test.ts",
    "test:customer-history": "npx tsx tests/customer-history.test.ts",
    "test:daily-operations": "npx tsx tests/daily-operations.test.ts",
    "test:marketing": "npx tsx tests/marketing.test.ts",
    "test:calendar-export": "npx tsx tests/calendar-export.test.ts",
    "test:all": "npm run architecture:check && npm run test:architecture && npm run test:files && npm run test:tenant && npm run test:booking && npm run test:permissions && npm run test:reliability && npm run test:cancellation-fill && npm run test:customer-history && npm run test:daily-operations && npm run test:marketing && npm run test:calendar-export && npm run test:factory-readiness && npm run test:factory-launch && npm run test:barber-mode && npm run test:specialty && npm run test:portfolio && npm run test:queue",
    "db:apply-rls": "tsx scripts/apply-rls.ts",
    "db:rls-status": "tsx scripts/rls-status.ts",
    "client:independence": "tsx scripts/client-independence.ts",
    "master:check": "npm run architecture:check && npm run client:independence && npm run lint && npm run typecheck && npx prisma validate && npx prisma generate && npx tsx scripts/perf-check.ts --strict && npm run build",
    "test:ci": "npx tsx tests/file-validation.test.ts && npx tsx tests/architecture.test.ts && npx tsx tests/barber-mode.test.ts && npx tsx tests/booking.test.ts && npx tsx tests/calendar-export.test.ts && npx tsx tests/cancellation-fill.test.ts && npx tsx tests/customer-history.test.ts && npx tsx tests/daily-operations.test.ts && npx tsx tests/factory-launch.test.ts && npx tsx tests/factory-readiness.test.ts && npx tsx tests/marketing.test.ts && npx tsx tests/observability.test.ts && npx tsx tests/payment-transitions.test.ts && npx tsx tests/portfolio.test.ts && npx tsx tests/queue.test.ts && npx tsx tests/reliability.test.ts && npx tsx tests/rls-enforcement.test.ts && npx tsx tests/role-permissions.test.ts && npx tsx tests/specialty-match.test.ts && npx tsx tests/tenant-isolation.test.ts && npx tsx tests/tenant-key-sync.test.ts",
    "test:files": "npx tsx tests/file-validation.test.ts",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test accessibility.spec.ts",
    "e2e:install-browsers": "playwright install chromium",
    "db:backup": "tsx scripts/backup.ts",
    "db:backup-verify": "tsx scripts/backup.ts --verify"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.7.0",
    "@prisma/client": "^5.19.0",
    "@radix-ui/react-avatar": "^1.1.0",
