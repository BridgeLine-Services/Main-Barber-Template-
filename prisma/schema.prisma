// ============================================================================
// Barber Booking System — Prisma Schema
// Multi-tenant: every business-scoped table has a businessId column.
// Every query MUST filter by businessId to prevent cross-shop data leakage.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Business (Tenant) ──────────────────────────────────────────────────────

model Business {
  payments               Payment[]
  id                     String    @id @default(cuid())
  name                   String
  slug                   String    @unique // URL slug for the shop
  logo                   String?
  primaryColor           String    @default("#1a1a1a") // dark / black theme default
  accentColor            String    @default("#d4af37") // gold accent default
  secondaryColor         String?   @default("#2a2a2a") // secondary surface color
  fontFamily             String? // "poppins", "inter", "montserrat", etc.
  themeMode              String    @default("dark") // "dark" or "light"
  phone                  String?
  email                  String?
  address                String?
  city                   String?
  state                  String?
  zipCode                String?
  latitude               Float?
  longitude              Float?
  timezone               String    @default("America/Los_Angeles") // IANA timezone
  instagram              String?
  facebook               String?
  tiktok                 String?
  youtube                String?
  xTwitter               String?
  googleBusinessProfile  String?
  hours                  Json? // { monday: { open: "09:00", close: "18:00", isOff: false }, ... }
  aboutText              String?   @db.Text
  teamSectionLabel       String? // e.g. 'Our Team', 'The Artists' — badge above heading on /barbers
  teamSectionTitle       String?   @db.Text // heading on /barbers page, e.g. 'Meet the Barbers'
  teamSectionDescription String?   @db.Text // paragraph below heading on /barbers page
  bookingPolicy          String?   @db.Text
  cancellationPolicy     String?   @db.Text
  latePolicy             String?   @db.Text
  noShowPolicyText       String?   @db.Text
  paymentPolicy          String?   @db.Text
  privacyPolicy          String?   @db.Text
  termsPolicy            String?   @db.Text

  // ─── Onboarding (persistent white-label setup status) ────────────────────
  onboardingCompleted   Boolean   @default(false)
  onboardingStep        String    @default("business") // current/last wizard step: business | branding | services | schedule | done
  onboardingCompletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Soft deactivation: shop closed (temporarily or permanently). Blocks
  // staff sign-ins and public bookings while preserving all data. Owners
  // keep access for export and one-click reactivation.
  deactivatedAt DateTime?

  users                        User[]
  staffInvitations             StaffInvitation[]
  barbers                      Barber[]
  services                     Service[]
  customers                    Customer[]
  appointments                 Appointment[]
  blockedTimes                 BlockedTime[]
  reviews                      Review[]
  auditLogs                    AuditLog[]
  notificationLogs             NotificationLog[]
  waitlistEntries              WaitlistEntry[]
  closures                     BusinessClosure[]
  rewardPrograms               BusinessRewardProgram[]
  barberServices               BarberService[]
  barberRewardPrograms         BarberRewardProgram[]
  intakeResponses              AppointmentIntakeResponse[]
  customerTags                 CustomerTagAssignment[]
  cancellationRecords          CancellationRecord[]
  noShowPolicies               NoShowPolicy[]
  retentionSettings            RetentionSettings?
  inventoryItems               InventoryItem[]
  marketingCampaigns           MarketingCampaign[]
  mediaAssets                  MediaAsset[]
  beforeAfterPairs             BeforeAfterPair[]
  seo                          BusinessSEO?
  availabilityOverrides        AvailabilityOverride[]
  faqs                         Faq[]
  websiteContent               WebsiteContent?
  bookingQuestions             BookingQuestion[]
  rescheduleHistory            RescheduleHistory[]
  portalVerificationChallenges PortalVerificationChallenge[]
  portalSessions               PortalSession[]

  walkInsWelcome                   Boolean                         @default(true)
  firstAvailableBookingEnabled     Boolean                         @default(true) // allow "First available" option in the booking flow
  parkingAvailable                 Boolean                         @default(false)
  paymentInPerson                  Boolean                         @default(true)
  paymentSettings                  PaymentSettings?
  commissionSettings               CommissionSettings?
  commissionRules                  CommissionRule[]
  barberCommissionParticipations   BarberCommissionParticipation[]
  commissionEntries                CommissionEntry[]
  timeClockSettings                TimeClockSettings?
  timeClockEntries                 TimeClockEntry[]
  payrollSettings                  PayrollSettings?
  payrollReports                   PayrollReport[]
  // Centralized feature configuration (Requirement 27): sparse map of
  // feature key -> enabled, validated against FEATURE_KEYS in src/lib/features.ts.
  // Existing boolean columns above stay authoritative for their feature.
  featureOverrides                 Json?
  customerRescheduleEnabled        Boolean                         @default(true)
  customerRescheduleMinNoticeHours Int                             @default(24)
  customerRescheduleWindowDays     Int?

  // Booking rules (server-side enforced in src/lib/availability.ts)
  minAdvanceBookingMinutes  Int                     @default(0) // customer must book at least N minutes ahead (0 = off)
  maxBookingWindowDays      Int? // appointments cannot start more than N days out (null = no limit)
  bufferMinutes             Int                     @default(0) // buffer after each appointment (business default)
  cancellationDeadlineHours Int                     @default(2) // customer cancellation cutoff before start (0 = no deadline)
  barberTimeClockAccesses   BarberTimeClockAccess[]

  @@index([slug])
}

// ─── Users (Auth) ───────────────────────────────────────────────────────────

enum UserRole {
  PLATFORM_OWNER
  OWNER
  BUSINESS_ADMIN
  BARBER
  CUSTOMER
}

model User {
  id                   String            @id @default(cuid())
  email                String            @unique
  passwordHash         String
  name                 String
  role                 UserRole          @default(BARBER)
  businessId           String?
  business             Business?         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  barberId             String? // links to Barber profile when role = BARBER
  customerId           String?           @unique // links to the Customer record when role = CUSTOMER (established server-side only)
  customer             Customer?         @relation(fields: [customerId], references: [id])
  staffInvitationsSent StaffInvitation[] @relation("SentStaffInvitations")
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  auditLogs                  AuditLog[]
  passwordResetToken         String?
  passwordResetExpires       DateTime?
  // Forces a password change on next login (set by the seed script for
  // generated/demo credentials; cleared by /change-password)
  mustChangePassword         Boolean    @default(false)
  // Last time the password was set/changed (set on register/reset/change)
  passwordChangedAt          DateTime?
  // Expiry for seed/admin-assigned temporary passwords (cleared on change)
  temporaryPasswordExpiresAt DateTime?
  // Staff account status: false blocks sign-in without destroying the
  // account, audit trail, or barber links (soft-deactivate for staff)
  isActive                   Boolean    @default(true)

  @@index([businessId])
}

// ─── Barbers ───────────────────────────────────────────────────────────────

model Barber {
  payments        Payment[] @relation("PaymentBarber")
  commissionRate  Float? // per-barber commission % override; null = use PaymentSettings default
  tipsOptOut      Boolean   @default(false) // barber-level payment preference: decline tips at checkout
  id              String    @id @default(cuid())
  businessId      String
  business        Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name            String
  slug            String?   @unique // URL slug for /barbers/[slug] pages, auto-generated from name
  photo           String?
  specialty       String? // e.g. "Fades • Tapers • Beard Work"
  bio             String?   @db.Text
  yearsExperience Int? // years behind the chair — optional, shown when set
  isActive        Boolean   @default(true)
  order           Int       @default(0)
  // Barber contact / social (self-editable via barber portal)
  phone           String?
  email           String?
  instagram       String?
  facebook        String?
  tiktok          String?
  website         String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  schedules               Schedule[]
  appointments            Appointment[]
  blockedTimes            BlockedTime[]
  services                BarberService[]
  waitlistEntries         WaitlistEntry[]
  rewardPrograms          BarberRewardProgram[]
  inventoryItems          InventoryItem[]
  reviews                 Review[]
  mediaAssets             MediaAsset[]
  beforeAfterPairs        BeforeAfterPair[]
  availabilityOverrides   AvailabilityOverride[]
  commissionRules         CommissionRule[]
  commissionParticipation BarberCommissionParticipation?
  commissionEntries       CommissionEntry[]
  timeClockAccess         BarberTimeClockAccess?
  timeClockEntries        TimeClockEntry[]
  payrollReportLines      PayrollReportLine[]
  payrollAdjustments      PayrollReportAdjustment[]

  @@index([businessId])
}

// ─── Schedules (recurring weekly hours per barber) ─────────────────────────

model Schedule {
  id        String   @id @default(cuid())
  barberId  String
  barber    Barber   @relation(fields: [barberId], references: [id], onDelete: Cascade)
  dayOfWeek Int // 0 = Sunday, 1 = Monday, ... 6 = Saturday
  startTime String // "09:00" (24h)
  endTime   String // "18:00" (24h)
  isOff     Boolean  @default(false)
  breaks    Json? // [{ start: "12:00", end: "13:00" }]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([barberId, dayOfWeek])
  @@index([barberId])
}

// ─── Availability Override (date-specific availability changes) ────────────
// Allows barbers to override their recurring schedule for specific dates.
// Examples: work a different shift, take a day off, add a special opening.
// The booking engine checks overrides FIRST, then falls back to recurring schedule.

model AvailabilityOverride {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  barberId    String
  barber      Barber   @relation(fields: [barberId], references: [id], onDelete: Cascade)
  date        DateTime @db.Date // the specific date being overridden
  isAvailable Boolean  @default(true) // false = day off / vacation
  startTime   String? // "10:00" (24h) — null when isAvailable = false
  endTime     String? // "18:00" (24h) — null when isAvailable = false
  breaks      Json? // [{ start: "12:00", end: "13:00" }] — overrides recurring breaks
  reason      String? // "Vacation", "Special opening", "Personal", etc.
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([barberId, date])
  @@index([businessId, date])
  @@index([barberId, date])
}

// ─── Services ──────────────────────────────────────────────────────────────

model Service {
  id                               String   @id @default(cuid())
  businessId                       String
  business                         Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name                             String
  description                      String?  @db.Text
  duration                         Int // minutes
  price                            Float // default price — payment is in person
  recommendedRebookingIntervalDays Int?
  isActive                         Boolean  @default(true)
  bufferMinutes                    Int? // per-service buffer override; null = use business.bufferMinutes
  order                            Int      @default(0)
  createdAt                        DateTime @default(now())
  updatedAt                        DateTime @updatedAt

  barbers          BarberService[]
  appointments     Appointment[]
  waitlistEntries  WaitlistEntry[]
  mediaAssets      MediaAsset[] // portfolio / example work linked to this service
  beforeAfterPairs BeforeAfterPair[]

  commissionRules CommissionRule[]

  @@index([businessId])
}

// BarberService: junction with per-barber configuration
// - priceOverride: null = use Service.price (default), number = custom price
// - durationOverride: null = use Service.duration (default), number = custom duration
// - isActive: barber can toggle offering this service without removing the link
// - sortOrder: barber-specific display order
model BarberService {
  barberId         String
  businessId       String?
  business         Business? @relation(fields: [businessId], references: [id])
  barber           Barber    @relation(fields: [barberId], references: [id], onDelete: Cascade)
  serviceId        String
  service          Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  priceOverride    Float?
  durationOverride Int?
  isActive         Boolean   @default(true)
  sortOrder        Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@id([barberId, serviceId])
  @@index([serviceId])
}

// ─── Media Asset (logo, hero, gallery, barber photos, etc.) ────────────────
// Reusable media layer for all images across the platform.
// type determines where the asset is used.

enum MediaType {
  LOGO
  HERO
  SHOP_PHOTO
  BARBER_PHOTO
  BARBER_PORTFOLIO
  GALLERY
  SERVICE_PHOTO
  OG_IMAGE
  FAVICON
}

model MediaAsset {
  id          String            @id @default(cuid())
  businessId  String
  business    Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  barberId    String? // null = shop asset, set for barber-specific assets
  barber      Barber?           @relation(fields: [barberId], references: [id], onDelete: Cascade)
  serviceId   String? // null = not service-specific; set for service-linked portfolio work
  service     Service?          @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  beforePairs BeforeAfterPair[] @relation("BeforeImage")
  afterPairs  BeforeAfterPair[] @relation("AfterImage")
  type        MediaType
  url         String // CDN / storage URL
  storageKey  String? // provider-specific key for deletion/management
  altText     String?
  caption     String?
  focalX      Int? // horizontal focal point, 0-100 (percent from left); null = center
  focalY      Int? // vertical focal point, 0-100 (percent from top); null = center
  sortOrder   Int               @default(0)
  isPublished Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([businessId, type])
  @@index([barberId, type])
  @@index([serviceId])
}

// ─── Before/After transformations (homepage module + reusable component) ───
// An owner-curated pair of REAL shop images presented as a verified
// transformation. Never auto-paired; always tenant-scoped.
model BeforeAfterPair {
  id            String     @id @default(cuid())
  businessId    String
  business      Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  beforeAssetId String
  beforeAsset   MediaAsset @relation("BeforeImage", fields: [beforeAssetId], references: [id], onDelete: Cascade)
  afterAssetId  String
  afterAsset    MediaAsset @relation("AfterImage", fields: [afterAssetId], references: [id], onDelete: Cascade)
  barberId      String? // optional attribution
  barber        Barber?    @relation(fields: [barberId], references: [id], onDelete: SetNull)
  serviceId     String? // optional service; drives the booking CTA preselection
  service       Service?   @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  caption       String?
  details       String?    @db.Text
  sortOrder     Int        @default(0)
  isPublished   Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([businessId, isPublished, sortOrder])
  @@index([barberId])
  @@index([serviceId])
}

// ─── Business SEO (owner-editable SEO settings) ───────────────────────────

model BusinessSEO {
  id                 String   @id @default(cuid())
  businessId         String   @unique
  business           Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  siteTitle          String?
  siteDescription    String?  @db.Text
  keywords           String?  @db.Text // comma-separated
  ogTitle            String?
  ogDescription      String?  @db.Text
  ogImage            String? // URL to OG image
  canonicalUrl       String?
  robotsIndex        Boolean  @default(true)
  robotsFollow       Boolean  @default(true)
  googleVerification String? // Google Search Console verification meta tag
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([businessId])
}

// ─── Retention / booking protection settings ───────────────────────────────

model RetentionSettings {
  id                           String   @id @default(cuid())
  businessId                   String   @unique
  business                     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  reminder24HoursEnabled       Boolean  @default(true)
  reminder2HoursEnabled        Boolean  @default(true)
  sameDayReminderEnabled       Boolean  @default(false)
  highRiskWarningThreshold     Int      @default(2)
  requireVerifiedContact       Boolean  @default(false)
  requireManualApproval        Boolean  @default(false)
  defaultRebookingIntervalDays Int      @default(21)
  dueSoonWindowDays            Int      @default(5)
  atRiskAfterDays              Int      @default(30)
  inactiveAfterDays            Int      @default(90)
  rebookingAutomationEnabled   Boolean  @default(true)
  rebookingCooldownDays        Int      @default(21)
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt
}

// ─── Customers ────────────────────────────────────────────────────────────

model Customer {
  stripeCustomerId String? // Stripe Customer id for card-on-file (never raw card data)

  payments        Payment[]
  id              String    @id @default(cuid())
  businessId      String
  business        Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  firstName       String
  lastName        String
  phone           String
  email           String
  notes           String?   @db.Text
  smsConsent      Boolean   @default(false)
  tags            String[]  @default([])
  preferences     Json?
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  archivedAt      DateTime? // soft-delete support
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  appointments        Appointment[]
  waitlistEntries     WaitlistEntry[]
  tagAssignments      CustomerTagAssignment[]
  cancellationRecords CancellationRecord[]
  notificationHistory NotificationLog[]       @relation("CustomerNotificationLogs")
  portalSessions      PortalSession[]
  linkedUser          User?

  @@unique([businessId, email])
  @@index([businessId])
  @@index([businessId, phone])
}

// ─── Appointments ──────────────────────────────────────────────────────────

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED
}

model Appointment {
  payments            Payment[]
  id                  String            @id @default(cuid())
  confirmationNumber  String            @unique // human-readable, e.g. BRB-8F42K
  customerAccessToken String            @unique // crypto.randomBytes(32).hex
  idempotencyKey      String?           @unique
  businessId          String
  business            Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId          String
  customer            Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  barberId            String
  barber              Barber            @relation(fields: [barberId], references: [id])
  serviceId           String
  service             Service           @relation(fields: [serviceId], references: [id])
  startTime           DateTime
  endTime             DateTime
  status              AppointmentStatus @default(PENDING)
  customerNotes       String?           @db.Text
  cancellationReason  String?
  noShowReason        String?
  noShowAt            DateTime?
  noShowMarkedBy      String?
  policiesAcceptedAt  DateTime?
  policyVersion       String?
  createdBy           String? // "ONLINE" | "MANUAL" | userId
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  notificationLogs   NotificationLog[]
  cancellationRecord CancellationRecord?
  intakeResponses    AppointmentIntakeResponse[]
  rescheduleHistory  RescheduleHistory[]

  commissionEntries CommissionEntry[]

  @@index([businessId, startTime])
  @@index([businessId, barberId, startTime])
  @@index([businessId, status])
  @@index([barberId, startTime])
  @@index([customerId])
  @@index([confirmationNumber])
  @@index([customerAccessToken])
}

// ─── Blocked Time (vacation, time off, custom blocks) ─────────────────────

model BlockedTime {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  barberId   String? // null = shop-wide block
  barber     Barber?  @relation(fields: [barberId], references: [id], onDelete: Cascade)
  startTime  DateTime
  endTime    DateTime
  reason     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([businessId, barberId])
  @@index([businessId, startTime])
}

// ─── Reviews ─────────────────────────────���────────────────────────────────
// Reviews can be shop-level (barberId = null) or barber-specific.
// Rating counts/averages are ALWAYS computed from actual records, never manually entered.

model Review {
  id             String   @id @default(cuid())
  businessId     String
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  barberId       String? // null = shop review, set = barber-specific review
  barber         Barber?  @relation(fields: [barberId], references: [id], onDelete: SetNull)
  authorName     String
  rating         Int // 1-5
  comment        String?  @db.Text
  isFeatured     Boolean  @default(false)
  isGoogleReview Boolean  @default(false)
  isPublished    Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([businessId])
  @@index([businessId, barberId])
  @@index([barberId])
}

// ─── Waitlist ─────────────────────────────────────────────────────────────

enum WaitlistStatus {
  WAITING
  NOTIFIED
  BOOKED
  EXPIRED
  CANCELLED
}

model WaitlistEntry {
  id                 String         @id @default(cuid())
  businessId         String
  business           Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId         String? // link if customer exists
  customer           Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  firstName          String
  lastName           String
  phone              String
  email              String
  barberId           String? // null = any barber
  barber             Barber?        @relation(fields: [barberId], references: [id], onDelete: SetNull)
  serviceId          String
  service            Service        @relation(fields: [serviceId], references: [id])
  preferredDate      DateTime       @db.Date
  preferredTimeRange String? // e.g. 'morning', 'afternoon', 'evening'
  status             WaitlistStatus @default(WAITING)
  notes              String?
  notifiedAt         DateTime?
  expiresAt          DateTime?
  claimToken         String?        @unique // secure token for customer to claim a notified slot
  offeredSlotStart   DateTime? // the released slot start time offered to this entry
  offeredSlotEnd     DateTime? // the released slot end time offered to this entry
  offeredBarberId    String? // barber id for the offered slot
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([businessId, status])
  @@index([businessId, preferredDate])
}

// ─── Notification Log ──────────────────────────────────────────────────────

enum NotificationType {
  BOOKING_CONFIRMATION
  BOOKING_REMINDER
  CANCELLATION_NOTICE
  RESCHEDULE_NOTICE
  CONTACT_FORM
  WAITLIST_NOTIFICATION
  REBOOKING_REMINDER
  MARKETING_CAMPAIGN
  STAFF_INVITE
}

enum NotificationChannel {
  EMAIL
  SMS
}

enum NotificationStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

model NotificationLog {
  id                String              @id @default(cuid())
  businessId        String?
  business          Business?           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointmentId     String? // optional link to appointment
  appointment       Appointment?        @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  customerId        String?
  customer          Customer?           @relation("CustomerNotificationLogs", fields: [customerId], references: [id], onDelete: Cascade)
  recipient         String // email or phone
  channel           NotificationChannel
  type              NotificationType
  content           String?             @db.Text
  status            NotificationStatus  @default(PENDING)
  errorMessage      String?
  failureReason     String?
  providerMessageId String?
  idempotencyKey    String?             @unique
  scheduledAt       DateTime?
  updatedAt         DateTime            @updatedAt
  sentAt            DateTime?
  createdAt         DateTime            @default(now())

  @@index([businessId, createdAt])
  @@index([appointmentId])
  @@index([status])
}

// ─── Audit Log ─────────────────────────────────────────────────────────────

enum AuditAction {
  PLATFORM_BUSINESS_CREATED
  PLATFORM_ACCESS_DENIED
  APPOINTMENT_CREATED
  APPOINTMENT_CANCELLED
  APPOINTMENT_RESCHEDULED
  APPOINTMENT_COMPLETED
  APPOINTMENT_NO_SHOW
  CUSTOMER_CREATED
  CUSTOMER_UPDATED
  CUSTOMER_ARCHIVED
  SERVICE_CREATED
  SERVICE_UPDATED
  SERVICE_DEACTIVATED
  BARBER_CREATED
  BARBER_UPDATED
  BARBER_DEACTIVATED
  SCHEDULE_MODIFIED
  BLOCKED_TIME_ADDED
  BLOCKED_TIME_REMOVED
  USER_INVITED
  USER_PASSWORD_CHANGED
  USER_ROLE_CHANGED
  USER_BARBER_LINK_CHANGED
  USER_DEACTIVATED
  LOGIN_SUCCESS
  LOGIN_FAILED
  BUSINESS_DEACTIVATED
  BUSINESS_REACTIVATED
  WEBSITE_CONTENT_PUBLISHED
  SETTINGS_UPDATED
  REBOOKING_REMINDER_SENT
  CAMPAIGN_CREATED
  CAMPAIGN_SENT
  LOYALTY_PROGRAM_UPDATED
  RECURRING_SERIES_CREATED
  INVENTORY_UPDATED
  CUSTOMER_TAG_ADDED
  CUSTOMER_TAG_REMOVED
  COMMISSION_ENABLED
  COMMISSION_DISABLED
  COMMISSION_RATE_CHANGED
  COMMISSION_MANUAL_ADJUSTMENT
  COMMISSION_REFUND_ADJUSTED
  COMMISSION_PAYOUT_UPDATED
  COMMISSION_ENTRY_DELETED
  COMMISSION_PARTICIPATION_CHANGED
  TIME_CLOCK_ENABLED
  TIME_CLOCK_DISABLED
  TIME_CLOCK_OVERTIME_RULES_UPDATED
  TIME_CLOCK_ACCESS_UPDATED
  TIME_CLOCK_ENTRY_CORRECTED
