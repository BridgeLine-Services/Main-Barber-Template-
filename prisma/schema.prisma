// ============================================================================
// BARBER TIME CLOCK (optional shop feature — owner has final authority)
//
// Shop-level TimeClockSettings.enabled is the master switch: OFF hides all
// time-clock UI and blocks new clock-in/out records, but NEVER deletes or
// hides historical entries (payroll history stays intact). Scheduling,
// appointments, and commissions continue independently.
// ============================================================================

// How pay periods are anchored for "this pay period" reporting.
enum PayPeriodType {
  WEEKLY // every pay period starts Monday
  BIWEEKLY // two-week periods starting the anchor Monday
}

// Shop-level configuration. One row per business (lazily created with the
// defaults below). Thresholds are DATA, not code: 0 disables that rule.
model TimeClockSettings {
  id         String   @id @default(cuid())
  businessId String   @unique
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // OWNER master switch — off = everyone off, UI hidden, no new records
  enabled Boolean @default(false)

  // Overtime rules (hours). 0 = that rule is disabled. Defaults are
  // configurable per shop; nothing here is hard-coded in code.
  dailyOvertimeThresholdHours  Float @default(8) // hours/day beyond which daily OT accrues
  weeklyOvertimeThresholdHours Float @default(40) // hours/week beyond which weekly OT accrues

  // Pay-period definition for the owner dashboard and payroll export
  payPeriodType       PayPeriodType @default(WEEKLY)
  payPeriodAnchorDate DateTime      @default("2024-01-01T00:00:00Z") // any Monday; periods count forward from it

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Owner-authorized per-barber access. A barber row defaults to eligible
// when the feature is on; the owner can exclude specific barbers or
// explicitly authorize a barber to view TEAM time records (default off —
// barbers otherwise see only their own hours).
model BarberTimeClockAccess {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  barberId   String   @unique // one access row per barber (1:1)
  barber     Barber   @relation(fields: [barberId], references: [id], onDelete: Cascade)

  eligible           Boolean @default(true) // may clock in/out (owner decision)
  canViewTeamRecords Boolean @default(false) // may view other barbers' hours

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, barberId])
}

// One row per shift. Rows are immutable history: clock-out and breaks are
// state transitions, and owner corrections append TimeClockEntryRevision
// rows (original → new value, who, when, reason) instead of silently
// rewriting values. `breakMinutes` is the total unpaid-break minutes for the
// shift (sum of closed break rows), deducted from worked hours.
model TimeClockEntry {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  barberId   String
  barber     Barber   @relation(fields: [barberId], references: [id], onDelete: Cascade)

  clockInAt    DateTime
  clockOutAt   DateTime? // null = still on the clock (open shift)
  breakMinutes Int       @default(0)
  notes        String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  breaks    TimeClockBreak[]
  revisions TimeClockEntryRevision[]

  @@index([businessId, barberId, clockInAt])
  @@index([businessId, clockInAt])
}

// Break rows. At most ONE open break per entry — enforced app-side plus a
// partial unique index (see migration) so a crashed client can't produce
// overlapping breaks.
model TimeClockBreak {
  id         String         @id @default(cuid())
  businessId String
  entryId    String
  entry      TimeClockEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  startedAt  DateTime
  endedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, entryId])
}

// Immutable correction trail. One row per changed field per correction:
// original value, new value, who changed it, when, and why.
model TimeClockEntryRevision {
  id         String         @id @default(cuid())
  businessId String
  entryId    String
  entry      TimeClockEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  changedByUserId String
  changedByName   String // display snapshot at edit time
  changedByEmail  String // identity snapshot at edit time
  field           String // clockInAt | clockOutAt | breakMinutes | notes
  originalValue   String // serialized before-value (ISO timestamp / text)
  newValue        String // serialized after-value
  reason          String // owner-supplied, required
  createdAt       DateTime @default(now())

  @@index([businessId, entryId, createdAt])
}

// ============================================================================
// PAYROLL-READY REPORTING (optional shop feature — owner has final authority)
//
// This is NOT a payroll processor. It never pays anyone, never withholds
// taxes, and never becomes a payroll provider: it aggregates payroll-ready
// information (time clock hours, completed-service revenue, tips,
// commissions, adjustments) into per-barber period reports with a CSV
// export for the owner to hand to their actual payroll provider.
//
// Shop-level PayrollSettings.enabled is the owner's master switch: OFF
// hides all payroll reporting (no report generation, no list, barber
// self-view off) while historical report rows remain untouched in the
// database. Appointments, payments, commissions, and the time clock keep
// working independently either way.
//
// Reports are immutable snapshots: PayrollReportLine freezes the numbers
// at generation time, and corrections after finalization append
// PayrollReportAdjustment rows (who, when, amount, reason) instead of
// rewriting finalized data.
// ============================================================================

enum PayrollPeriodType {
  WEEKLY // Monday-based week
  BIWEEKLY // two-week periods from the anchor Monday
  MONTHLY // calendar month in the shop timezone
  CUSTOM // owner-defined length in days
}

enum PayrollReportStatus {
  DRAFT
  REVIEWED
  EXPORTED
  FINALIZED
}

// Owner-defined shop configuration. One row per business (lazily created
// with the safe defaults below).
model PayrollSettings {
  id         String   @id @default(cuid())
  businessId String   @unique
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // OWNER master switch — off = reporting hidden, generation blocked,
  // history preserved.
  enabled Boolean @default(false)

  // Owner-defined pay period for report generation.
  payPeriodType       PayrollPeriodType @default(WEEKLY)
  payPeriodAnchorDate DateTime          @default("2024-01-01T00:00:00Z") // a Monday; periods count forward from it
  customPeriodDays    Int               @default(14) // used when payPeriodType = CUSTOM

  // Owner-controlled: may an individual barber see THEIR OWN payroll
  // summary? Never other barbers' data, never shop totals.
  barberSelfView Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One payroll-ready report per generated pay period. The lines are a
// frozen snapshot; status moves forward only (DRAFT → REVIEWED →
// EXPORTED → FINALIZED, with direct finalization allowed from any
// non-finalized state).
model PayrollReport {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  status      PayrollReportStatus @default(DRAFT)
  periodType  PayrollPeriodType
  periodStart DateTime
  periodEnd   DateTime // exclusive end
  periodLabel String // human snapshot, e.g. "Oct 1 – Oct 7, 2026"

  createdByUserId String
  reviewedAt      DateTime?
  exportedAt       DateTime?
  finalizedAt     DateTime?

  notes String?

  lines       PayrollReportLine[]
  adjustments PayrollReportAdjustment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, periodStart])
  @@index([businessId, status, createdAt])
}

// Per-barber frozen line of a report. Values are snapshots at generation
// time; later source-data changes never rewrite a stored line.
model PayrollReportLine {
  id         String       @id @default(cuid())
  businessId String // tenant key (RLS-enforced; no opposite relation needed)
  reportId   String
  report     PayrollReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  barberId   String
  barber     Barber       @relation(fields: [barberId], references: [id], onDelete: Cascade)

  barberName String // display snapshot at generation time

  serviceRevenue  Float
  tips            Float
  commission      Float
  adjustments     Float // commission-era adjustments (manual + refund) at generation
  regularHours    Float
  overtimeHours   Float
  totalHours      Float
  estimatedPayout Float // commission + tips + adjustments

  @@unique([reportId, barberId])
  @@index([businessId, reportId])
}

// Post-generation manual adjustments — the ONLY way to change a finalized
// report's effective numbers. Rows append (never rewrite lines), carry
// the author and a required reason, and are applied on top of the line
// snapshot when the report is displayed or exported.
model PayrollReportAdjustment {
  id         String       @id @default(cuid())
  businessId String // tenant key (RLS-enforced; no opposite relation needed)
  reportId   String
  report     PayrollReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  barberId   String
  barber     Barber       @relation(fields: [barberId], references: [id], onDelete: Cascade)

  amount          Float // net manual correction (either sign)
  reason          String // owner-supplied, required
  createdByUserId String
  createdAt       DateTime @default(now())

  @@index([businessId, reportId, barberId])
}
