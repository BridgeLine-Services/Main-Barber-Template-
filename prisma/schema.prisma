// ─── Payment architecture (Requirement 23) ──────────────────────────────
enum PaymentKind {
  CHARGE // service payment
  DEPOSIT // required upfront deposit
  TIP // gratuity
  REFUND // reversal of a previous payment
  CANCELLATION_FEE // late-cancel fee charged by policy
  NO_SHOW_FEE // missed-appointment fee charged by policy
}

enum PaymentMethod {
  IN_PERSON // pay at the shop (default template behavior)
  CARD // online card payment (e.g. Stripe)
  CASH // cash collected at the shop (POS)
}

enum PaymentStatus {
  PENDING // created, awaiting settlement
  PROCESSING // submitted to provider, not yet settled
  SUCCEEDED // settled
  FAILED // declined/errored (retryable)
  CANCELED // abandoned/canceled before settlement
  REFUNDED // fully reversed after succeeding
  PARTIALLY_REFUNDED // reversed for less than the full amount
}

enum BookingQuestionType {
  SHORT_TEXT
  LONG_TEXT
  YES_NO
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  PHONE
  EMAIL
  DATE
}

model BookingQuestion {
  id         String                      @id @default(cuid())
  businessId String
  business   Business                    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  label      String
  key        String
  type       BookingQuestionType
  required   Boolean                     @default(false)
  isActive   Boolean                     @default(true)
  sortOrder  Int                         @default(0)
  helpText   String?
  options    Json?
  createdAt  DateTime                    @default(now())
  updatedAt  DateTime                    @updatedAt
  responses  AppointmentIntakeResponse[]

  @@unique([businessId, key])
  @@index([businessId, isActive, sortOrder])
}

model AppointmentIntakeResponse {
  id              String              @id @default(cuid())
  appointmentId   String
  businessId      String?
  business        Business?           @relation(fields: [businessId], references: [id])
  appointment     Appointment         @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  questionId      String?
  question        BookingQuestion?    @relation(fields: [questionId], references: [id], onDelete: SetNull)
  questionKey     String
  questionLabel   String
  questionType    BookingQuestionType
  questionOptions Json?
  answer          Json
  createdAt       DateTime            @default(now())

  @@index([appointmentId])
}

// ─── Payment architecture (Requirement 23) ──────────────────────────────
// Provider-agnostic payment ledger. The template ships pay-at-shop
// (IN_PERSON) only; the PaymentProvider interface in src/lib/payments/
// lets a deployment add an online provider (e.g. Stripe) without
// touching booking logic. No card data is ever stored here — only
// provider references, amounts and statuses (see docs/PAYMENTS.md).
model Payment {
  id                String        @id @default(cuid())
  businessId        String
  business          Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointmentId     String?
  appointment       Appointment?  @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  customerId        String?
  customer          Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  barberId          String? // barber who performed the work (commission + history filter)
  barber            Barber?       @relation("PaymentBarber", fields: [barberId], references: [id], onDelete: SetNull)
  kind              PaymentKind
  method            PaymentMethod
  provider          String // provider id, e.g. "in_person", "stripe"
  providerRefId     String? // provider's transaction/intent id — never card data
  amount            Float
  taxAmount         Float         @default(0) // tax collected on this line (settings rate at sale time)
  refundedAmount    Float         @default(0) // running total reversed against this payment
  currency          String        @default("USD")
  status            PaymentStatus @default(PENDING)
  failureReason     String?
  idempotencyKey    String?       @unique // deduplicates provider retries & webhooks
  metadata          Json?
  originalPaymentId String? // set on REFUND rows: the payment being reversed
  originalPayment   Payment?      @relation("PaymentRefunds", fields: [originalPaymentId], references: [id], onDelete: SetNull)
  refunds           Payment[]     @relation("PaymentRefunds")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId])
  @@index([appointmentId])
  @@index([customerId])
  @@index([barberId])
  @@index([businessId, status])
  @@index([businessId, createdAt])
  @@index([businessId, barberId, createdAt])
}

// ─── Payments & POS (optional; owner-controlled) ──────────────────────────
// Owner master switch + granular POS configuration. When `enabled` is
// false the shop operates purely in pay-at-shop mode (the template
// default): booking never requires payment, no payment UI is shown, and
// the Payment ledger stays untouched. One row per business.
model PaymentSettings {
  id         String   @id @default(cuid())
  businessId String   @unique
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  enabled                Boolean @default(false) // master "Payments & POS" switch (owner-only)
  allowBarberCheckout    Boolean @default(true) // barbers may run checkout on their own appointments
  tipsEnabled            Boolean @default(true)
  tipPresets             Json? // [15,18,20,25] percent options; custom always allowed
  taxEnabled             Boolean @default(false)
  taxRatePercent         Float   @default(0)
  depositsEnabled        Boolean @default(false)
  depositType            String  @default("PERCENT") // PERCENT | FLAT
  depositValue           Float   @default(20)
  cancellationFeeEnabled Boolean @default(false)
  cancellationFeeAmount  Float   @default(0)
  noShowFeeEnabled       Boolean @default(false)
  noShowFeeAmount        Float   @default(0)
  cardOnFileEnabled      Boolean @default(false) // save cards via Stripe only, never stored locally
  commissionEnabled      Boolean @default(false)
  commissionRatePercent  Float? // default % of service revenue; Barber.commissionRate overrides
  receiptsEmailEnabled   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Barber Commissions (optional; owner-controlled) ─────────────────────────
// Commission ledger + configuration. The OWNER is the final authority:
// CommissionSettings.enabled is the shop-level master switch. When it is
// off, calculations stop and commission dashboards hide, but historical
// CommissionEntry rows are never deleted — financial history is immutable.
// A barber-level participation preference (BarberCommissionParticipation)
// can only further restrict; it can never override an owner-disabled shop.
enum CommissionRateType {
  PERCENT // percent of the commissioned base
  FIXED // flat amount per completed service/product
}

enum CommissionSource {
  SERVICE
  PRODUCT
  TIP
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
  ADJUSTED
}

enum TipsCommissionMode {
  EXCLUDED // tips are the barber's own, never commissioned (default)
  PASS_THROUGH // full tip is added to the barber's payout
  PERCENT // tips commissioned at tipsCommissionPercent
}

// One row per business: owner master switch + default rates. Rule rows
// (CommissionRule) override these defaults per barber and/or per service.
model CommissionSettings {
  id         String   @id @default(cuid())
  businessId String   @unique
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  enabled                  Boolean            @default(false) // OWNER master switch — off = everyone off
  barberSelfViewEnabled    Boolean            @default(false) // owner allows barbers to view their own commissions
  defaultRateType          CommissionRateType @default(PERCENT)
  defaultRatePercent       Float              @default(40)
  defaultRateFixed         Float              @default(0)
  productCommissionEnabled Boolean            @default(false) // commission POS product line items
  productRateType          CommissionRateType @default(PERCENT)
  productRatePercent       Float              @default(10)
  productRateFixed         Float              @default(0)
  tipsMode                 TipsCommissionMode @default(EXCLUDED)
  tipsCommissionPercent    Float              @default(0)
  includeNoShowFees        Boolean            @default(false) // commission NO_SHOW_FEE revenue
  calculateOnUnpaid        Boolean            @default(false) // commission completed-but-unpaid appointments (owner opt-in)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Commission rate overrides. Resolution priority (highest first):
//   (barber + service) > (barber + any service) > (any barber + service) > defaults
// A null barberId matches any barber; a null serviceId matches any service.
// scopeKey (`barberId|serviceId`, '' for null) exists because Postgres treats
// NULLs as distinct in unique indexes — it keeps at most one rule per scope.
model CommissionRule {
  id          String             @id @default(cuid())
  businessId  String
  business    Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  barberId    String?
  barber      Barber?            @relation(fields: [barberId], references: [id], onDelete: Cascade)
  serviceId   String?
  service     Service?           @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  scopeKey    String
  rateType    CommissionRateType @default(PERCENT)
  ratePercent Float? // required when rateType = PERCENT
  rateFixed   Float? // required when rateType = FIXED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, scopeKey])
  @@index([businessId])
}

// Barber-level participation preference. Owner setting always wins:
// shop OFF = everyone off regardless of this row; shop ON = a barber who
// opts out here is excluded from commission calculations.
model BarberCommissionParticipation {
  id           String   @id @default(cuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  barberId     String   @unique // one participation preference per barber (1:1 relation)
  barber       Barber   @relation(fields: [barberId], references: [id], onDelete: Cascade)
  participates Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, barberId])
}

// One ledger row per commissioned event. Rows are immutable history:
// refunds/voids adjust `refundAdjustment` (automatic) and owner corrections
// adjust `adjustment` (manual) rather than rewriting amounts, so the original
// calculation stays auditable.
// Effective payout = commissionAmount + adjustment + refundAdjustment.
model CommissionEntry {
  id               String             @id @default(cuid())
  businessId       String
  business         Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  barberId         String
  barber           Barber             @relation(fields: [barberId], references: [id], onDelete: Cascade)
  appointmentId    String?
  appointment      Appointment?       @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  paymentId        String? // originating Payment row (charges/tips; refunds reference the original charge)
  source           CommissionSource
  grossAmount      Float // commissioned base (post-discount, excl. tax)
  discountAmount   Float              @default(0)
  rateType         CommissionRateType
  ratePercent      Float?
  rateFixed        Float?
  commissionAmount Float // originally computed commission
  refundAdjustment Float              @default(0) // automatic reduction from refunds/voids (always <= 0)
  adjustment       Float              @default(0) // net manual correction by the owner (either sign)
  status           CommissionStatus   @default(PENDING)
  paidAt           DateTime?
  paidByUserId     String? // user id of whoever marked it paid (plain column — audit trail, no FK needed)
  paidAmount       Float              @default(0)
  notes            String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([businessId, barberId, createdAt])
  @@index([businessId, status])
  @@index([businessId, createdAt])
  @@index([paymentId])
}

// Stripe webhook idempotency: every processed event id is recorded so
// replays (Stripe retries, duplicate deliveries) are no-ops.
model StripeEvent {
  id          String   @id @default(cuid())
  eventId     String   @unique
  type        String
  processedAt DateTime @default(now())
}

model RescheduleHistory {
  id                String      @id @default(cuid())
  businessId        String
  business          Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointmentId     String
  appointment       Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  previousStartTime DateTime
  previousEndTime   DateTime
  newStartTime      DateTime
  newEndTime        DateTime
  actor             String      @default("CUSTOMER")
  createdAt         DateTime    @default(now())

  @@index([businessId, createdAt])
  @@index([appointmentId])
}

model PortalVerificationChallenge {
  id          String    @id @default(cuid())
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contactHash String
  channel     String
  codeHash    String
  expiresAt   DateTime
  attempts    Int       @default(0)
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([businessId, contactHash, createdAt])
