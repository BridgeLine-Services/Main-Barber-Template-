// ============================================================================
// Barber Booking System — Prisma Schema
// Multi-tenant: every business-scoped table has a businessId column.
// Every query MUST filter by businessId to prevent cross-shop data leakage.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Business (Tenant) ──────────────────────────────────────────────────────

model Business {
  id                     String  @id @default(cuid())
  name                   String
  slug                   String  @unique // URL slug for the shop
  logo                   String?
  primaryColor           String  @default("#1a1a1a") // dark / black theme default
  accentColor            String  @default("#d4af37") // gold accent default
  secondaryColor         String? @default("#2a2a2a") // secondary surface color
  fontFamily             String? // "poppins", "inter", "montserrat", etc.
  themeMode              String  @default("dark") // "dark" or "light"
  phone                  String?
  email                  String?
  address                String?
  city                   String?
  state                  String?
  zipCode                String?
  latitude               Float?
  longitude              Float?
  timezone               String  @default("America/Los_Angeles") // IANA timezone
  instagram              String?
  facebook               String?
  tiktok                 String?
  youtube                String?
  xTwitter               String?
  googleBusinessProfile  String?
  hours                  Json? // { monday: { open: "09:00", close: "18:00", isOff: false }, ... }
  aboutText              String? @db.Text
  teamSectionLabel       String? // e.g. 'Our Team', 'The Artists' — badge above heading on /barbers
  teamSectionTitle       String? @db.Text // heading on /barbers page, e.g. 'Meet the Barbers'
  teamSectionDescription String? @db.Text // paragraph below heading on /barbers page
  bookingPolicy          String? @db.Text
  cancellationPolicy     String? @db.Text
  latePolicy             String? @db.Text
  noShowPolicyText       String? @db.Text
  paymentPolicy          String? @db.Text
  privacyPolicy          String? @db.Text
  termsPolicy            String? @db.Text

  // ─── Onboarding (persistent white-label setup status) ────────────────────
  onboardingCompleted   Boolean   @default(false)
  onboardingStep        String    @default("business") // current/last wizard step: business | branding | services | schedule | done
  onboardingCompletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                        User[]
  barbers                      Barber[]
  services                     Service[]
  customers                    Customer[]
  appointments                 Appointment[]
  blockedTimes                 BlockedTime[]
  reviews                      Review[]
  auditLogs                    AuditLog[]
  notificationLogs             NotificationLog[]
  waitlistEntries              WaitlistEntry[]
  closures                     BusinessClosure[]
  rewardPrograms               BusinessRewardProgram[]
  customerTags                 CustomerTagAssignment[]
  cancellationRecords          CancellationRecord[]
  noShowPolicies               NoShowPolicy[]
  retentionSettings            RetentionSettings?
  inventoryItems               InventoryItem[]
  marketingCampaigns           MarketingCampaign[]
  mediaAssets                  MediaAsset[]
  seo                          BusinessSEO?
  availabilityOverrides        AvailabilityOverride[]
  faqs                         Faq[]
  websiteContent               WebsiteContent?
  bookingQuestions             BookingQuestion[]
  rescheduleHistory            RescheduleHistory[]
  portalVerificationChallenges PortalVerificationChallenge[]
  portalSessions               PortalSession[]

  walkInsWelcome                   Boolean @default(true)
  firstAvailableBookingEnabled     Boolean @default(true) // allow "First available" option in the booking flow
  parkingAvailable                 Boolean @default(false)
  paymentInPerson                  Boolean @default(true)
  customerRescheduleEnabled        Boolean @default(true)
  customerRescheduleMinNoticeHours Int     @default(24)
  customerRescheduleWindowDays     Int?

  @@index([slug])
}

// ─── Users (Auth) ───────────────────────────────────────────────────────────

enum UserRole {
  OWNER
  BARBER
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         UserRole  @default(BARBER)
  businessId   String?
  business     Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  barberId     String? // links to Barber profile when role = BARBER
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  auditLogs                  AuditLog[]
  passwordResetToken         String?
  passwordResetExpires       DateTime?
  // Forces a password change on next login (set by the seed script for
  // generated/demo credentials; cleared by /change-password)
  mustChangePassword         Boolean    @default(false)
  // Last time the password was set/changed (set on register/reset/change)
  passwordChangedAt          DateTime?
  // Expiry for seed/admin-assigned temporary passwords (cleared on change)
  temporaryPasswordExpiresAt DateTime?

  @@index([businessId])
}

// ─── Barbers ───────────────────────────────────────────────────────────────

model Barber {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  slug       String?  @unique // URL slug for /barbers/[slug] pages, auto-generated from name
  photo      String?
  specialty  String? // e.g. "Fades • Tapers • Beard Work"
  bio        String?  @db.Text
  isActive   Boolean  @default(true)
  order      Int      @default(0)
  // Barber contact / social (self-editable via barber portal)
  phone      String?
  email      String?
  instagram  String?
  facebook   String?
  tiktok     String?
  website    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  schedules             Schedule[]
  appointments          Appointment[]
  blockedTimes          BlockedTime[]
  services              BarberService[]
  waitlistEntries       WaitlistEntry[]
  rewardPrograms        BarberRewardProgram[]
  inventoryItems        InventoryItem[]
  reviews               Review[]
  mediaAssets           MediaAsset[]
  availabilityOverrides AvailabilityOverride[]

  @@index([businessId])
}

// ─── Schedules (recurring weekly hours per barber) ─────────────────────────

model Schedule {
  id        String   @id @default(cuid())
  barberId  String
  barber    Barber   @relation(fields: [barberId], references: [id], onDelete: Cascade)
  dayOfWeek Int // 0 = Sunday, 1 = Monday, ... 6 = Saturday
  startTime String // "09:00" (24h)
  endTime   String // "18:00" (24h)
  isOff     Boolean  @default(false)
  breaks    Json? // [{ start: "12:00", end: "13:00" }]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([barberId, dayOfWeek])
  @@index([barberId])
}

// ─── Availability Override (date-specific availability changes) ────────────
// Allows barbers to override their recurring schedule for specific dates.
// Examples: work a different shift, take a day off, add a special opening.
// The booking engine checks overrides FIRST, then falls back to recurring schedule.

model AvailabilityOverride {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  barberId    String
  barber      Barber   @relation(fields: [barberId], references: [id], onDelete: Cascade)
  date        DateTime @db.Date // the specific date being overridden
  isAvailable Boolean  @default(true) // false = day off / vacation
  startTime   String? // "10:00" (24h) — null when isAvailable = false
  endTime     String? // "18:00" (24h) — null when isAvailable = false
  breaks      Json? // [{ start: "12:00", end: "13:00" }] — overrides recurring breaks
  reason      String? // "Vacation", "Special opening", "Personal", etc.
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([barberId, date])
  @@index([businessId, date])
  @@index([barberId, date])
}

// ─── Services ──────────────────────────────────────────────────────────────

model Service {
  id                               String   @id @default(cuid())
  businessId                       String
  business                         Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name                             String
  description                      String?  @db.Text
  duration                         Int // minutes
  price                            Float // default price — payment is in person
  recommendedRebookingIntervalDays Int?
  isActive                         Boolean  @default(true)
  order                            Int      @default(0)
  createdAt                        DateTime @default(now())
  updatedAt                        DateTime @updatedAt

  barbers         BarberService[]
  appointments    Appointment[]
  waitlistEntries WaitlistEntry[]
  mediaAssets     MediaAsset[] // portfolio / example work linked to this service

  @@index([businessId])
}

// BarberService: junction with per-barber configuration
// - priceOverride: null = use Service.price (default), number = custom price
// - durationOverride: null = use Service.duration (default), number = custom duration
// - isActive: barber can toggle offering this service without removing the link
// - sortOrder: barber-specific display order
model BarberService {
  barberId         String
  barber           Barber   @relation(fields: [barberId], references: [id], onDelete: Cascade)
  serviceId        String
  service          Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  priceOverride    Float?
  durationOverride Int?
  isActive         Boolean  @default(true)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@id([barberId, serviceId])
  @@index([serviceId])
}

// ─── Media Asset (logo, hero, gallery, barber photos, etc.) ────────────────
// Reusable media layer for all images across the platform.
// type determines where the asset is used.

enum MediaType {
  LOGO
  HERO
  SHOP_PHOTO
  BARBER_PHOTO
  BARBER_PORTFOLIO
  GALLERY
  SERVICE_PHOTO
  OG_IMAGE
  FAVICON
}

model MediaAsset {
  id          String    @id @default(cuid())
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  barberId    String? // null = shop asset, set for barber-specific assets
  barber      Barber?   @relation(fields: [barberId], references: [id], onDelete: Cascade)
  serviceId   String? // null = not service-specific; set for service-linked portfolio work
  service     Service?  @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  type        MediaType
  url         String // CDN / storage URL
  storageKey  String? // provider-specific key for deletion/management
  altText     String?
  caption     String?
  sortOrder   Int       @default(0)
  isPublished Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([businessId, type])
  @@index([barberId, type])
  @@index([serviceId])
}

// ─── Business SEO (owner-editable SEO settings) ───────────────────────────

model BusinessSEO {
  id                 String   @id @default(cuid())
  businessId         String   @unique
  business           Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  siteTitle          String?
  siteDescription    String?  @db.Text
  keywords           String?  @db.Text // comma-separated
  ogTitle            String?
  ogDescription      String?  @db.Text
  ogImage            String? // URL to OG image
  canonicalUrl       String?
  robotsIndex        Boolean  @default(true)
  robotsFollow       Boolean  @default(true)
  googleVerification String? // Google Search Console verification meta tag
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([businessId])
}

// ─── Retention / booking protection settings ───────────────────────────────

model RetentionSettings {
  id                           String   @id @default(cuid())
  businessId                   String   @unique
  business                     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  reminder24HoursEnabled       Boolean  @default(true)
  reminder2HoursEnabled        Boolean  @default(true)
  sameDayReminderEnabled       Boolean  @default(false)
  highRiskWarningThreshold     Int      @default(2)
  requireVerifiedContact       Boolean  @default(false)
  requireManualApproval        Boolean  @default(false)
  defaultRebookingIntervalDays Int      @default(21)
  dueSoonWindowDays            Int      @default(5)
  atRiskAfterDays              Int      @default(30)
  inactiveAfterDays            Int      @default(90)
  rebookingAutomationEnabled   Boolean  @default(true)
  rebookingCooldownDays        Int      @default(21)
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt
}

// ─── Customers ────────────────────────────────────────────────────────────

model Customer {
  id              String    @id @default(cuid())
  businessId      String
  business        Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  firstName       String
  lastName        String
  phone           String
  email           String
  notes           String?   @db.Text
  smsConsent      Boolean   @default(false)
  tags            String[]  @default([])
  preferences     Json?
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  archivedAt      DateTime? // soft-delete support
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  appointments        Appointment[]
  waitlistEntries     WaitlistEntry[]
  tagAssignments      CustomerTagAssignment[]
  cancellationRecords CancellationRecord[]
  notificationHistory NotificationLog[]       @relation("CustomerNotificationLogs")
  portalSessions      PortalSession[]

  @@unique([businessId, email])
  @@index([businessId])
  @@index([businessId, phone])
}

// ─── Appointments ──────────────────────────────────────────────────────────

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED
}

model Appointment {
  id                  String            @id @default(cuid())
  confirmationNumber  String            @unique // human-readable, e.g. BRB-8F42K
  customerAccessToken String            @unique // crypto.randomBytes(32).hex
  idempotencyKey      String?           @unique
  businessId          String
  business            Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId          String
  customer            Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  barberId            String
  barber              Barber            @relation(fields: [barberId], references: [id])
  serviceId           String
  service             Service           @relation(fields: [serviceId], references: [id])
  startTime           DateTime
  endTime             DateTime
  status              AppointmentStatus @default(PENDING)
  customerNotes       String?           @db.Text
  cancellationReason  String?
  noShowReason        String?
  noShowAt            DateTime?
  noShowMarkedBy      String?
  policiesAcceptedAt  DateTime?
  policyVersion       String?
  createdBy           String? // "ONLINE" | "MANUAL" | userId
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  notificationLogs   NotificationLog[]
  cancellationRecord CancellationRecord?
  intakeResponses    AppointmentIntakeResponse[]
  rescheduleHistory  RescheduleHistory[]

  @@index([businessId, startTime])
  @@index([businessId, barberId, startTime])
  @@index([businessId, status])
  @@index([barberId, startTime])
  @@index([customerId])
  @@index([confirmationNumber])
  @@index([customerAccessToken])
}

// ─── Blocked Time (vacation, time off, custom blocks) ─────────────────────

model BlockedTime {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  barberId   String? // null = shop-wide block
  barber     Barber?  @relation(fields: [barberId], references: [id], onDelete: Cascade)
  startTime  DateTime
  endTime    DateTime
  reason     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([businessId, barberId])
  @@index([businessId, startTime])
}

// ─── Reviews ─────────────────────────────���────────────────────────────────
// Reviews can be shop-level (barberId = null) or barber-specific.
// Rating counts/averages are ALWAYS computed from actual records, never manually entered.

model Review {
  id             String   @id @default(cuid())
  businessId     String
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  barberId       String? // null = shop review, set = barber-specific review
  barber         Barber?  @relation(fields: [barberId], references: [id], onDelete: SetNull)
  authorName     String
  rating         Int // 1-5
  comment        String?  @db.Text
  isFeatured     Boolean  @default(false)
  isGoogleReview Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([businessId])
  @@index([businessId, barberId])
  @@index([barberId])
}

// ─── Waitlist ─────────────────────────────────────────────────────────────

enum WaitlistStatus {
  WAITING
  NOTIFIED
  BOOKED
  EXPIRED
  CANCELLED
}

model WaitlistEntry {
  id                 String         @id @default(cuid())
  businessId         String
  business           Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId         String? // link if customer exists
  customer           Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  firstName          String
  lastName           String
  phone              String
  email              String
  barberId           String? // null = any barber
  barber             Barber?        @relation(fields: [barberId], references: [id], onDelete: SetNull)
  serviceId          String
  service            Service        @relation(fields: [serviceId], references: [id])
  preferredDate      DateTime       @db.Date
  preferredTimeRange String? // e.g. 'morning', 'afternoon', 'evening'
  status             WaitlistStatus @default(WAITING)
  notes              String?
  notifiedAt         DateTime?
  expiresAt          DateTime?
  claimToken         String?        @unique // secure token for customer to claim a notified slot
  offeredSlotStart   DateTime? // the released slot start time offered to this entry
  offeredSlotEnd     DateTime? // the released slot end time offered to this entry
  offeredBarberId    String? // barber id for the offered slot
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([businessId, status])
  @@index([businessId, preferredDate])
}

// ─── Notification Log ──────────────────────────────────────────────────────

enum NotificationType {
  BOOKING_CONFIRMATION
  BOOKING_REMINDER
  CANCELLATION_NOTICE
  RESCHEDULE_NOTICE
  CONTACT_FORM
  WAITLIST_NOTIFICATION
  REBOOKING_REMINDER
  MARKETING_CAMPAIGN
}

enum NotificationChannel {
  EMAIL
  SMS
}

enum NotificationStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

model NotificationLog {
  id                String              @id @default(cuid())
  businessId        String?
  business          Business?           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointmentId     String? // optional link to appointment
  appointment       Appointment?        @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  customerId        String?
  customer          Customer?           @relation("CustomerNotificationLogs", fields: [customerId], references: [id], onDelete: Cascade)
  recipient         String // email or phone
  channel           NotificationChannel
  type              NotificationType
  content           String?             @db.Text
  status            NotificationStatus  @default(PENDING)
  errorMessage      String?
  failureReason     String?
  providerMessageId String?
  idempotencyKey    String?             @unique
  scheduledAt       DateTime?
  updatedAt         DateTime            @updatedAt
  sentAt            DateTime?
  createdAt         DateTime            @default(now())

  @@index([businessId, createdAt])
  @@index([appointmentId])
  @@index([status])
}

// ─── Audit Log ─────────────────────────────────────────────────────────────

enum AuditAction {
  APPOINTMENT_CREATED
  APPOINTMENT_CANCELLED
  APPOINTMENT_RESCHEDULED
  APPOINTMENT_COMPLETED
  APPOINTMENT_NO_SHOW
  CUSTOMER_CREATED
  CUSTOMER_UPDATED
  CUSTOMER_ARCHIVED
  SERVICE_CREATED
  SERVICE_UPDATED
  SERVICE_DEACTIVATED
  BARBER_CREATED
  BARBER_UPDATED
  BARBER_DEACTIVATED
  SCHEDULE_MODIFIED
  BLOCKED_TIME_ADDED
  BLOCKED_TIME_REMOVED
  USER_INVITED
  USER_PASSWORD_CHANGED
  USER_ROLE_CHANGED
  USER_DEACTIVATED
  LOGIN_SUCCESS
  LOGIN_FAILED
  SETTINGS_UPDATED
  REBOOKING_REMINDER_SENT
  CAMPAIGN_CREATED
  CAMPAIGN_SENT
  LOYALTY_PROGRAM_UPDATED
  RECURRING_SERIES_CREATED
  INVENTORY_UPDATED
  CUSTOMER_TAG_ADDED
  CUSTOMER_TAG_REMOVED
  CANCELLATION_RECORDED
  NO_SHOW_POLICY_UPDATED
  AVAILABILITY_OVERRIDE_ADDED
  AVAILABILITY_OVERRIDE_REMOVED
  BRANDING_UPDATED
  SEO_UPDATED
  MEDIA_UPLOADED
  MEDIA_DELETED
  BARBER_PROFILE_UPDATED
  BARBER_SCHEDULE_UPDATED
}

model AuditLog {
  id         String      @id @default(cuid())
  businessId String?
  business   Business?   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     AuditAction
  entityType String? // "Appointment", "Customer", "Service", etc.
  entityId   String?
  oldValues  Json?
  newValues  Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime    @default(now())

  @@index([businessId, createdAt])
  @@index([userId])
  @@index([action])
}

// ─── Business Closures (Holidays / Special Hours) ──────────────────────────

model BusinessClosure {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  title       String // e.g. "Christmas Day", "Summer Vacation"
  description String?
  startDate   DateTime @db.Date
  endDate     DateTime @db.Date
  isAllDay    Boolean  @default(true)
  startTime   String? // "09:00"
  endTime     String? // "14:00"
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([businessId, startDate, endDate])
}

// ─── Loyalty / Reward Programs ─────────────────────────────────────────────

enum RewardProgramType {
  VISITS
  POINTS
}

enum RewardType {
  DISCOUNT
  FREE_SERVICE
  CUSTOM
}

model BusinessRewardProgram {
  id              String            @id @default(cuid())
  businessId      String
  business        Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name            String            @default("Loyalty Program")
  type            RewardProgramType @default(VISITS)
  isActive        Boolean           @default(true)
  pointsPerDollar Float? // for POINTS type: $1 spent = X points
  config          Json // [{ threshold: 5, reward: "$5 off", rewardType: "DISCOUNT", discountValue: 5 }, ...]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([businessId, isActive])
}

model BarberRewardProgram {
  id              String            @id @default(cuid())
  barberId        String
  barber          Barber            @relation(fields: [barberId], references: [id], onDelete: Cascade)
  name            String            @default("Barber Loyalty")
  type            RewardProgramType @default(VISITS)
  isActive        Boolean           @default(false)
  pointsPerDollar Float?
  config          Json
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([barberId, isActive])
}

// ─── Customer Tags ────────────────────────────────────────────────────��─────

enum CustomerTag {
  VIP
  NEW_CUSTOMER
  REGULAR
  AT_RISK
  INACTIVE
  NO_SHOW_RISK
  BIRTHDAY_MONTH
}

model CustomerTagAssignment {
  id         String      @id @default(cuid())
  customerId String
  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  businessId String
  business   Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  tag        CustomerTag
  assignedAt DateTime    @default(now())
  assignedBy String? // userId or "AUTO"
  note       String?

  @@unique([customerId, tag])
  @@index([businessId, tag])
  @@index([customerId])
}

// ─── Cancellation Reasons ───────────────────────────────────────────────────

enum CancellationReason {
  TOO_EXPENSIVE
  SCHEDULE_CONFLICT
  FEELING_SICK
  FOUND_ANOTHER_TIME
  OTHER
}

model CancellationRecord {
  id            String             @id @default(cuid())
  appointmentId String             @unique
  appointment   Appointment        @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  businessId    String
  business      Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId    String
  customer      Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  reason        CancellationReason
  note          String?
  createdAt     DateTime           @default(now())

  @@index([businessId, reason])
  @@index([businessId, createdAt])
}

// ─── No-Show Policy ──────────────────────────────────────────���───────────────

model NoShowPolicy {
  id             String   @id @default(cuid())
  businessId     String
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  firstNoShow    String   @default("warning")
  secondNoShow   String   @default("flag")
  thirdNoShow    String   @default("require_confirmation")
  requireDeposit Boolean  @default(false)
  depositAmount  Float?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([businessId])
}

// ─── Inventory ───────────────────────────────────────────────────────────────

model InventoryItem {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  barberId   String? // null = shop-wide, specific barber = barber-owned
  barber     Barber?  @relation(fields: [barberId], references: [id], onDelete: Cascade)
  name       String
  sku        String?
  stock      Float    @default(0)
  unit       String   @default("each")
  threshold  Float    @default(5)
  cost       Float?
  vendor     String?
  notes      String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([businessId])
  @@index([businessId, barberId])
}

// ─── Marketing Campaigns ─────────────────────────────────────────────────────

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENT
  ARCHIVED
}

enum CampaignAudience {
  INACTIVE_30
  INACTIVE_45
  INACTIVE_60
  INACTIVE_90
  NOT_REBOOKED
  CANCELLED
  NO_SHOWED
  BIRTHDAY_MONTH
  NOT_VISITED_BARBER
  USED_SERVICE
  ALL_CUSTOMERS
}

model MarketingCampaign {
  id             String           @id @default(cuid())
  businessId     String
  business       Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name           String
  subject        String
  body           String           @db.Text
  audience       CampaignAudience
  audienceConfig Json?
  status         CampaignStatus   @default(DRAFT)
  sentAt         DateTime?
  recipientCount Int?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([businessId, status])
  @@index([businessId, audience])
}

// ─── Website content and booking intake ────────────────────────────────────

model WebsiteContent {
  id                    String   @id @default(cuid())
  businessId            String   @unique
  business              Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  heroEyebrow           String?
  heroTitle             String?
  heroDescription       String?  @db.Text
  heroImageUrl          String?
  heroPrimaryCtaLabel   String?
  heroPrimaryCtaHref    String?
  heroSecondaryCtaLabel String?
  heroSecondaryCtaHref  String?
  showServices          Boolean  @default(true)
  showTeam              Boolean  @default(true)
  showReviews           Boolean  @default(true)
  showVisit             Boolean  @default(true)
  showFaq               Boolean  @default(true)
  showFinalCta          Boolean  @default(true)
  servicesTitle         String?
  servicesDescription   String?  @db.Text
  teamTitle             String?
  teamDescription       String?  @db.Text
  reviewsTitle          String?
  reviewsDescription    String?  @db.Text
  visitTitle            String?
  visitDescription      String?  @db.Text
  faqTitle              String?
  faqDescription        String?  @db.Text
  finalCtaTitle         String?
  finalCtaDescription   String?  @db.Text
  featuredReviewCount   Int      @default(3)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

enum BookingQuestionType {
  SHORT_TEXT
  LONG_TEXT
  YES_NO
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  PHONE
  EMAIL
  DATE
}

model BookingQuestion {
  id         String                      @id @default(cuid())
  businessId String
  business   Business                    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  label      String
  key        String
  type       BookingQuestionType
  required   Boolean                     @default(false)
  isActive   Boolean                     @default(true)
  sortOrder  Int                         @default(0)
  helpText   String?
  options    Json?
  createdAt  DateTime                    @default(now())
  updatedAt  DateTime                    @updatedAt
  responses  AppointmentIntakeResponse[]

  @@unique([businessId, key])
  @@index([businessId, isActive, sortOrder])
}

model AppointmentIntakeResponse {
  id              String              @id @default(cuid())
  appointmentId   String
  appointment     Appointment         @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  questionId      String?
  question        BookingQuestion?    @relation(fields: [questionId], references: [id], onDelete: SetNull)
  questionKey     String
  questionLabel   String
  questionType    BookingQuestionType
  questionOptions Json?
  answer          Json
  createdAt       DateTime            @default(now())

  @@index([appointmentId])
}

model RescheduleHistory {
  id                String      @id @default(cuid())
  businessId        String
  business          Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointmentId     String
  appointment       Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  previousStartTime DateTime
  previousEndTime   DateTime
  newStartTime      DateTime
  newEndTime        DateTime
  actor             String      @default("CUSTOMER")
  createdAt         DateTime    @default(now())

  @@index([businessId, createdAt])
  @@index([appointmentId])
}

model PortalVerificationChallenge {
  id          String    @id @default(cuid())
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contactHash String
  channel     String
  codeHash    String
  expiresAt   DateTime
  attempts    Int       @default(0)
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([businessId, contactHash, createdAt])
}

model PortalSession {
  id         String    @id @default(cuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([businessId, customerId, expiresAt])
}

// ─── FAQ (Database-driven, owner-editable) ──────────────────────────────────

model Faq {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category   String
  question   String
  answer     String   @db.Text
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([businessId, isActive, sortOrder])
}
