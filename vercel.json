{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "node scripts/vercel-build.mjs",
  "installCommand": "node scripts/vercel-build.mjs --validate-only && npm ci",
  "crons": [
    {
      "path": "/api/cron/reminders",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/memberships",
      "schedule": "15 9 * * *"
    },
    {
      "path": "/api/cron/review-requests",
      "schedule": "30 9 * * *"
    }
  ]
}
